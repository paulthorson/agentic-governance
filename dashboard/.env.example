# Agentic Governance dashboard — local secrets (never commit real values)
#
# Admin metrics are localhost-only (see src/middleware.ts). Remote identity
# login is not part of this app. This file is a stub for optional local
# overrides only.
#
# Example optional local override (unused by current admin gate):
# PORT=3000
#
# Trust X-Forwarded-Host for the admin hostname. Default off. Enable only
# behind a proxy that overwrites that header.
# AG_TRUST_X_FORWARDED_HOST=1
