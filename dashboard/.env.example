# Agentic Governance dashboard — local secrets (never commit real values)

# Auth.js / NextAuth v5
AUTH_SECRET=
# Generate with: npx auth secret

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed into /admin.
# Empty / unset = nobody (fail closed). Deployer must supply real Google emails.
# GitHub noreply addresses (e.g. *@users.noreply.github.com) are NOT Google
# accounts and will not work as Google OAuth login identities.
# Example placeholder only — replace with your Google account email(s):
ADMIN_EMAILS=you@example.com
