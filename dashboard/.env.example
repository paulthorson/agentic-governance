# Agentic Governance dashboard — local secrets (never commit real values)

# Auth.js / NextAuth v5
AUTH_SECRET=
# Generate with: npx auth secret

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional comma-separated allowlist override/extension (in addition to hardcoded noreply address)
ADMIN_EMAILS=noreply address
